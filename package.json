{
  "name": "procurement-portal",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "description": "MVP порталу заявок на закупівлю (тестове середовище)",
  "scripts": {
    "start": "node scripts/start.mjs",
    "build": "vite build",
